# Lab setup for eval/run_paper.sh. Copy to lab.local.env (gitignored)
# next to this file and fill in; the scripts read it if it exists. A variable already set in the
# environment takes precedence.
#
# SERVER_HOST  the host that runs server.py, reachable from the device over the internet; the
#              firmware sends to the same address (src/server_config.local.h)
# AP_HOST      the access point (Morse Micro HaLowLink 2), reached over SSH to inject loss
# SERVER_KEY   SSH key for root@SERVER_HOST and root@AP_HOST
# CONSOLE_PORT the devkit's UART, e.g. /dev/serial/by-id/usb-STMicroelectronics_STLINK-V3_<serial>-if02
# PPK2_PORT    the Power Profiler Kit II, e.g. /dev/serial/by-id/usb-Nordic_Semiconductor_PPK2_<serial>-if01
SERVER_HOST="${SERVER_HOST:-192.0.2.1}"
AP_HOST="${AP_HOST:-192.168.0.140}"
SERVER_KEY="${SERVER_KEY:-$HOME/.ssh/id_ed25519}"
CONSOLE_PORT="${CONSOLE_PORT:-}"
PPK2_PORT="${PPK2_PORT:-}"
